generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  income
  expense
}

enum AccountType {
  cash
  ewallet
  bank
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  expenses      Expense[]
  accounts      Account[]
  categories    Category[]
  budgets       Budget[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id             Int         @id @default(autoincrement())
  userId         Int         @map("user_id")
  name           String      @db.VarChar(100)
  type           AccountType @default(cash)
  initialBalance Decimal     @default(0) @map("initial_balance") @db.Decimal(15, 2)
  isDefault      Boolean     @default(false) @map("is_default")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, type])
  @@map("accounts")
}

model Category {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(100)
  normalizedName String    @map("normalized_name") @db.VarChar(100)
  colorHex       String    @default("#64748B") @map("color_hex") @db.Char(7)
  userId         Int?      @map("user_id")
  isDefault      Boolean   @default(false) @map("is_default")
  type           TransactionType @default(expense)
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  budgets        Budget[]
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, normalizedName, type])
  @@index([isDefault])
  @@map("categories")
}

model Expense {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  categoryId  Int      @map("category_id")
  type        TransactionType @default(expense)
  title       String   @db.VarChar(150)
  amount      Decimal  @db.Decimal(15, 2)
  expenseDate DateTime @map("expense_date") @db.DateTime(3)
  location    String?  @db.VarChar(255)
  notes       String?  @db.Text
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, expenseDate])
  @@index([userId, categoryId])
  @@map("expenses")
}

model Budget {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  categoryId Int      @map("category_id")
  amount     Decimal  @db.Decimal(15, 2)
  month      DateTime @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}
